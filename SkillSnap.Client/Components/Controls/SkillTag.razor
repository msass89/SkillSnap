
<div class="skill-tag">
    <p>@SkillName</p>
    <div>
        @for (int i = 1; i <= 5; i++)
        {
            <span style="color: @(i <= Level ? "gold" : "lightgray");">
                &#9733; <!--Star as an HTML-Entity-->
            </span>
        }
    </div>
</div>


@code {
    [Parameter]
    public string SkillName { get; set; } = "";

    [Parameter]
    public int Level { get; set; }

}