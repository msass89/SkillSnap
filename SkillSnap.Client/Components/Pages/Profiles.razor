@page "/profiles"
@using SkillSnap.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<AuthorizeView Roles="User">
    <Authorized>
        @if(portfolioUserList != null && portfolioUserList?.Count != 0)
        {
            @foreach (PortfolioUserDto portfolioUser in portfolioUserList) {
                if(portfolioUser != null)
                {
                    <ProfileCard Name="@portfolioUser.FullName" Bio="@portfolioUser.Bio" ProfilePictureUrl="@portfolioUser.ProfileImageUrl"></ProfileCard>
                }
            }
        }
    </Authorized>
    <NotAuthorized>
        The User is not authorized
    </NotAuthorized>
</AuthorizeView>
@inject UserService userService;


@code {

    private List<PortfolioUserDto> portfolioUserList;

    protected override async Task OnInitializedAsync()
    {
        portfolioUserList = await userService.GetAllUsersAsync();
    }
}