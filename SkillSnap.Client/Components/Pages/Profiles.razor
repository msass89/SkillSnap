@page "/profiles"
@using SkillSnap.Shared
@inject UserService userService;


@if(portfolioUserList == null)
{
    <p>Load data...</p>
}
else
{
    @foreach (PortfolioUserDto portfolioUser in portfolioUserList)
    {
        if (portfolioUser != null)
        {
            <ProfilePreview UserId="@portfolioUser.UserId" Name="@portfolioUser.FullName" Bio="@portfolioUser.Bio"
                            ProfilePictureUrl="@portfolioUser.ProfileImageUrl"></ProfilePreview>
        }
    }
}


@code {
    private List<PortfolioUserDto>? portfolioUserList;

    protected override async Task OnInitializedAsync()
    {
        portfolioUserList = await userService.GetAllUsersAsync();
    }
}