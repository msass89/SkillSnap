@page "/register"
@inject AuthService AuthService;
@inject NavigationManager NavigationManager;

<EditForm Model="@registrationModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator /> <!-- Enables validation based on attributes -->

    <div class="form-container">
        <h1 class="page-title">Register</h1>
        <h2>Create a new account</h2>
        <hr />

        <div class="form-floating mb-3">
            <InputText @bind-Value="registrationModel.FullName" class="form-control" placeholder="John Doe" />
            <label asp-for="Input.DisplayName">Full Name</label>
            <ValidationMessage For="@(() => registrationModel.FullName)" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="registrationModel.Email" class="form-control" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <ValidationMessage For="@(() => registrationModel.Email)" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="registrationModel.Password" type="password" class="form-control" placeholder="password" />
            <label asp-for="Input.Password">Password</label>
            <ValidationMessage For="@(() => registrationModel.Password)" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="registrationModel.ConfirmPassword" type="password" class="form-control" placeholder="password" />
            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
            <ValidationMessage For="@(() => registrationModel.ConfirmPassword)" />
        </div>
        <button id="registerSubmit" type="submit" class="btn btn-lg btn-primary">Register</button>
        <p>@ErrorMessage</p>
    </div>

</EditForm>

@code {
    private RegistrationModel registrationModel = new();
    bool registrationResult = false;

    string? ErrorMessage = "";

    private async Task HandleValidSubmit()
    {
        registrationResult = await AuthService.RegisterAsync(registrationModel.FullName, registrationModel.Email, registrationModel.Password);

        if(!registrationResult)
            ErrorMessage = "User registration was not successful";
        else
        {
            // login if registration was succesfull
            TokenResponseDto responseDto = await AuthService.LoginAsync(new LoginRequestDto(registrationModel.Email, registrationModel.Password));
            if (!responseDto.IsAuthSuccessful)
            {
                ErrorMessage = responseDto.ErrorMessage;
            }
            else
            {
                NavigationManager.NavigateTo("/myprofile");
            }
        }
        
    }
}
