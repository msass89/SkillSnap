@page "/userprofile/{userId}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using SkillSnap.Shared

@inject UserService userService;
@inject SkillService skillService;
@inject ProjectServices projectService;
@inject AuthenticationStateProvider authStateProvider;
@inject NavigationManager navigationManager;

<AuthorizeView Roles="User">
    <Authorized>
        @if(portfolioUserDto == null)
        {
            <p>Load data...</p>
        }
        else 
        {
            <CascadingValue TValue="bool" Value="@OwnProfile">
                <div class="form-container">
                    <h1 class="text-center">Your profile</h1>
                    <hr />
                    <div class="form-group m-3 text-center">
                        <ProfilePictureSection ProfileImageUrl="@portfolioUserDto.ProfileImageUrl" PictureChanged="OnPictureChanged"/>
                        <h5 class="card-title">@portfolioUserDto.FullName</h5>
                    </div>
                    <div class="form-group m-3">
                        <BioSection Bio="@portfolioUserDto.Bio" BioChanged="OnBioChanged"/>
                    </div>
                    <div class="form-group m-3">
                        <SkillSection skillResponseDtoList="@skillResponseDtoList" SkillAdded="OnSkillAdded" DeleteSkill="OnSkillDeleted"/>
                    </div>
                    <div class="form-group m-3">
                        <ProjectsSection Projects="@projectResponseDtoList" CreateProject="OnProjectAdded" DeleteProject="OnProjectDelete"/>
                    </div>
                    @if(!string.IsNullOrWhiteSpace(message))
                    {
                        <p style="@messageColor">@message</p>
                    }
                </div>
            </CascadingValue>
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool OwnProfile = false;
    private string message = string.Empty;
    private string messageColor = string.Empty;
    private PortfolioUserDto? portfolioUserDto;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private List<SkillResponseDto> skillResponseDtoList = new();
    private List<ProjectResponseDto>? projectResponseDtoList = new ();

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();

        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var authUserId = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;

        if(UserId == authUserId)
        {
            OwnProfile = true;
        }
    }

    private async Task LoadData()
    {
        var skillsTask = skillService.GetSkillsByUserAsync(UserId);
        var userTask = userService.GetUserByIdAsync(UserId);
        var projectsTask = projectService.GetProjectsAsync(UserId);

        await Task.WhenAll(skillsTask, userTask, projectsTask);

        skillResponseDtoList = await skillsTask;
        portfolioUserDto = await userTask;
        projectResponseDtoList = await projectsTask;

        StateHasChanged();
    }


    private async Task OnBioChanged(string newBio)
    {
        portfolioUserDto?.Bio = newBio;

        await SaveProfileChanges();
    }

    private async Task OnPictureChanged(string newUrl)
    {
        portfolioUserDto?.ProfileImageUrl = newUrl;

        await SaveProfileChanges();
    }

    private async Task OnSkillAdded(CreateSkillRequestDto skill)
    {
        if (UserId == null)
            return;

        var createSkillDto = new CreateSkillRequestDto
        {
            Name = skill.Name,
            Level = skill.Level,
            ApplicationUserId = UserId
        };

        var response = await skillService.CreateSkillAsync(createSkillDto);

        if (response == null)
            return;

        if(response.Success)
        {
            skillResponseDtoList?.Add(response);

            StateHasChanged();
        }

        UpdateMessage(response.Success, response.Message);
    }

    private async Task OnSkillDeleted(int id)
    {
        var response = await skillService.DeleteSkillByIdAsync(id);

        if(response.Success)
        {
            var skill = skillResponseDtoList?.FirstOrDefault(skill => skill.Id == id);

            if(skill == null)
                return;

            skillResponseDtoList?.Remove(skill);
            StateHasChanged();
        }

        UpdateMessage(response.Success, response.Message);
    }

    private async Task OnProjectAdded(CreateProjectRequestDto project)
    {
        if (UserId == null)
            return;

        var createProjectRequestDto = new CreateProjectRequestDto
        {
            Title = project.Title,
            Description = project.Description,
            ImageUrl = project.ImageUrl,
            ApplicationUserId = UserId
        };

        var response = await projectService.CreateProjectAsync(createProjectRequestDto);

        if (response == null)
            return;

        if(response.Success)
        {
            projectResponseDtoList?.Add(response);

            StateHasChanged();
        }

        UpdateMessage(response.Success, response.Message);
    }

    private async Task OnProjectDelete(int projectId)
    {
        var response = await projectService.DeleteProjectByIdAsync(projectId);

        if(response.Success)
        {
            var project = projectResponseDtoList?.FirstOrDefault(project => project.Id == projectId);

            if(project == null)
                return;

            projectResponseDtoList?.Remove(project);
            StateHasChanged();
        }

        UpdateMessage(response.Success, response.Message);
    }


    private async Task SaveProfileChanges()
    {
        if(portfolioUserDto == null || UserId == null)
            return;

        PortfolioUserDto request = new PortfolioUserDto
        {
            UserId = UserId,
            FullName = portfolioUserDto.FullName,
            Bio = portfolioUserDto.Bio,
            ProfileImageUrl = portfolioUserDto.ProfileImageUrl
        };

        var response = await userService.UpdateUserByIdAsync(request);

        UpdateMessage(response.Success, response.Message);
    }

    private void UpdateMessage(bool success, string responseMessage)
    {
        messageColor = success ? "color:green;" : "color:red";
        message = responseMessage;
    }
}