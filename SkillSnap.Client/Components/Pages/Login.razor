@page "/login"
@using System.Security.Claims
@inject AuthService authService;
@inject NavigationManager navigationManager;
@inject AuthenticationStateProvider authStateProvider;


@if (ShowAuthError)
{
    <div class="alert alert-danger" role="alert">
        <p>@Error</p>
    </div>
}

<EditForm Model="@loginModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator /> <!-- Enables validation based on attributes -->

    <div class="form-container">
        <h1 class="page-title">Login</h1>
        <h2>Login with your account</h2>
        <hr />

        <div class="form-floating mb-4">
            <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="name@example.com" />
            <label class="form-label">Email</label>
            <ValidationMessage For="@(() => loginModel.Email)" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="Enter password here" />
            <label class="form-label">Password</label>
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>
        <div>
            <button id="login-submit" type="submit" class="btn btn-lg btn-primary">Log in</button>
        </div>
        <div>
            <p>
                <a href="/Register" asp-page="/Register">Register as a new user</a>
            </p>
        </div>
    </div>
</EditForm>

@code {
    private LoginModel loginModel = new();

    public bool ShowAuthError { get; set; }
    public string? Error { get; set; }


    private async Task HandleValidSubmit()
    {
        ShowAuthError = false;

        var loginRequestDto = new LoginRequestDto(
            email: loginModel.Email,
            password: loginModel.Password
        );

        TokenResponseDto result = await authService.LoginAsync(loginRequestDto);
        
        if (!result.IsAuthSuccessful)
        {
            Error = result.ErrorMessage;
            ShowAuthError = true;
        }
        else
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;

            navigationManager.NavigateTo($"/userprofile/{userId}"); 
        }
    }
}
