@if(addProject)
{
    <label for="project-title">Title: </label>
    <InputTextArea class="big-input" id="project-title" @bind-Value="@projectTitle"></InputTextArea>
    <label for="project-description">Description: </label>
    <InputTextArea class="big-input" id="project-description" @bind-Value="@projectDescription"></InputTextArea>
    <div style="display:flex;justify-content:flex-end;">
        <button style="text-align:right" class="btn btn-secondary" @onclick="ToggleEditing">Skip</button>
        &nbsp;
        <button style="text-align:right" class="btn btn-success" @onclick="NotifyParent">Save</button>
    </div>
}
else
{
    <div style="display:flex;justify-content:flex-end;">
        <button style="text-align:right" class="btn btn-primary" @onclick="ToggleEditing">Add Project</button>
    </div>
}



@code {
    [Parameter]
    public EventCallback<CreateProjectRequestDto> CreateProject { get; set; }

    private string projectTitle;
    private string projectDescription;
    private bool addProject = false;

    private void ToggleEditing()
    {
        addProject = !addProject;
    }

    private void NotifyParent()
    {
        var project = new CreateProjectRequestDto
        {
            Title = projectTitle,
            Description = projectDescription,
            ImageUrl = "",
            ApplicationUserId = string.Empty
        };

        CreateProject.InvokeAsync(project);

        addProject = false;
    }
}