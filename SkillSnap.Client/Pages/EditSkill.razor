<label for="bio"><b>Skills:</b></label>
<br />
<div class="skill-container">
    @if(skillResponseDtoList != null && skillResponseDtoList?.Count > 0)
    {
        @foreach(var skill in skillResponseDtoList)
        {
            @if(skill != null)
            {
                <EditSkillTag Name="@skill.Name" Level="@skill.Level" SkillId="@skill.Id" DeleteSkill="NotifyParentDeleteSkill"/>
            }
        }
    }
    else
    {
        <p class="card-text" style="font-style:italic">Add some skills here...</p>
    }
    <AddSkillTag SkillAdded="NotifyParentCreateSkill"/>
</div>

@code {
    [Parameter]
    public List<SkillResponseDto> skillResponseDtoList {get; set;}

    [Parameter]
    public EventCallback<CreateSkillRequestDto> SkillAdded { get; set; }

    [Parameter]
    public EventCallback<int> DeleteSkill { get; set; }

    private void NotifyParentCreateSkill(CreateSkillRequestDto skill)
    {
        SkillAdded.InvokeAsync(skill);
    }

    private void NotifyParentDeleteSkill(int id)
    {
        DeleteSkill.InvokeAsync(id);
    }

}