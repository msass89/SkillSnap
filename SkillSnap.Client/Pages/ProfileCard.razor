
<div class="card">
    <div class="card-body text-center">
        @if(string.IsNullOrWhiteSpace(ProfilePictureUrl))
        {
            <img src="https://mockmind-api.uifaces.co/content/abstract/28.jpg" class="rounded-circle mb-3" alt="Profile Picture" width="100" height="100" />
        }
        else
        {
            <img src="@ProfilePictureUrl" class="rounded-circle mb-3" alt="Profile Picture" width="100" height="100" />
        }
        @if(Name != null)
        {
            <h5 class="card-title">@Name</h5>
        }
        @if(Bio != null)
        {
            <p class="card-text">@Bio</p>
        }
    </div>
</div>

@code {

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Bio { get; set; }

    [Parameter]
    public string? ProfilePictureUrl { get; set; }

}