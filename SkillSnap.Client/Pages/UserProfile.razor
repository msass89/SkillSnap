@page "/userprofile"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<AuthorizeView Roles="User">
    <Authorized>
        <!--The user: @context.User.FindFirst(ClaimTypes.Name).Value is authorized-->
        <ProfileCard Name="@(context.User.Identity?.Name ?? "Unknown User")" Bio="@portfolioUser.Bio" ProfilePictureUrl="@portfolioUser.ProfileImageUrl"></ProfileCard>
    </Authorized>
    <NotAuthorized>
        The User is not authorized
    </NotAuthorized>
</AuthorizeView>



@code {
    private PortfolioUser portfolioUser = new PortfolioUser
    {
        Name = "Shawnta Padberg",
        Bio = "Passionate full-stack developer",
        ProfileImageUrl = "https://mockmind-api.uifaces.co/content/abstract/28.jpg"
    };
}