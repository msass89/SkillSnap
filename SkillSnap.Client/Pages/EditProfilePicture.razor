<img src="@ProfileImageUrl" class="rounded-circle mb-3" alt="Profile Picture" width="100" height="100" @onclick="@ToggleEditing"/>
@if(showInput)
{
    <br />
    <label for="image-url">New profile image url: </label>
    <br />
    <InputText style="width:90%" id="image-url" @bind-Value="@imageUrlInput"></InputText>
    <br />
    <button class="btn btn-secondary" @onclick="@ToggleEditing">Skip</button>
    <button class="btn btn-primary" @onclick="@NotifyParent">Save</button>
    <br />
    <br />
}

@code {
    [Parameter]
    public string? ProfileImageUrl { get; set; }

    private bool showInput = false;
    private string imageUrlInput = string.Empty;

    [Parameter]
    public EventCallback<string> PictureChanged { get; set; }

    private void ToggleEditing()
    {
        imageUrlInput = ProfileImageUrl ?? "";
        showInput = !showInput;
    }

    private async Task NotifyParent()
    {
        await PictureChanged.InvokeAsync(imageUrlInput);
        showInput = false;
    }
}